{
  "name": "cadence-scheduler",
  "version": "0.6.4",
  "description": "Edge-native scheduling engine \u2014 the complete single-team product, on Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/fakes.ts"
  },
  "files": [
    "src",
    "migrations",
    "README.md",
    "LICENSE",
    "assets",
    "wrangler.toml",
    "DEPLOYMENT.md"
  ],
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.toml",
    "migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.toml",
    "migrate": "wrangler d1 migrations apply DB --remote --config wrangler.toml",
    "test": "vitest run",
    "test:core": "vitest run test/core",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview": "wrangler dev --config wrangler.preview.toml --ip 127.0.0.1"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.19",
    "satori": "^0.33.5",
    "zod": "^4.6.7",
    "harfbuzzjs": "0.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0",
    "@cloudflare/vitest-plugin": "^1.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "overrides": {
    "satori": {
      "fflate": "^0.7.5"
    }
  }
}
